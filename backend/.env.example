# ============================================================
# GAD-AMS BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# Duplicate this file to .env and adjust values for your environment
# ============================================================

# Environment: 'development' for local debugging, 'production' for Hostinger
CI_ENVIRONMENT = development

# Backend Base API URL (must include trailing slash)
# Local: http://localhost:8080/api/
# Hostinger: https://bsugad.com/api/
app.baseURL = "http://localhost:8080/api/"

# Frontend URL (for password reset links, email verification, etc.)
# Local: http://localhost:5173
# Hostinger: https://bsugad.com
FRONTEND_URL = "http://localhost:5173"

# Allowed CORS Origins (comma-separated, without trailing slashes)
# Local: http://localhost:5173,http://localhost:5174
# Hostinger: https://bsugad.com
CORS_ALLOWED_ORIGINS = "http://localhost:5173,http://localhost:5174"

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
database.default.hostname = 127.0.0.1
database.default.database = your_database_name
database.default.username = your_database_user
database.default.password = your_database_password
database.default.DBDriver = MySQLi
database.default.port = 3306

# ============================================================
# CLOUD STORAGE (Cloudflare R2) - Optional in local dev
# ============================================================
USE_CLOUD_STORAGE = false
R2_ENDPOINT = ""
R2_ACCESS_KEY = ""
R2_SECRET_KEY = ""
R2_BUCKET = "gad-ams"

# ============================================================
# EMAIL / SMTP (Brevo / Hostinger Mail)
# ============================================================
FROM_EMAIL = "noreply@bsugad.com"
SMTP_HOST = "smtp.hostinger.com"
SMTP_PORT = 465
SMTP_USER = "your_email@bsugad.com"
SMTP_PASS = "your_email_password"
SMTP_CRYPTO = "ssl"

# ============================================================
# CLOUDFLARE TURNSTILE CAPTCHA SECRET KEY
# Test dummy secret key (always passes): 1x0000000000000000000000000000000AA
# ============================================================
TURNSTILE_SECRET_KEY = "1x0000000000000000000000000000000AA"
