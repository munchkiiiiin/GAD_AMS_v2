# ============================================================
# GAD-AMS FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# Duplicate this file to .env and adjust values for your environment
# ============================================================

# Backend API endpoint URL (without trailing slash)
# Local dev: http://localhost:8080/api
# Hostinger production: https://bsugad.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# Cloudflare Turnstile Site Key
# Testing key (always passes): 1x00000000000000000000AA
# Production key: Obtain from Cloudflare Turnstile dashboard
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
